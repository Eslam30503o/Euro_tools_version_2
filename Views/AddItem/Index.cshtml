@model WarehouseApp.Models.AddItemViewModel
@{
    ViewData["Title"] = "Add New Item";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h1 class="display-5 text-primary mb-1">
                        <i class="fas fa-plus-circle me-3"></i>Add New Item
                    </h1>
                    <p class="text-muted mb-0">Create a new item in your warehouse inventory</p>
                </div>
                <div class="d-flex gap-2 mt-2 mt-md-0">
                    <a asp-controller="AddItem" asp-action="Import" class="btn btn-success">Import</a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
                        <i class="fas fa-home me-2"></i>Home
                    </a>
                    <a asp-controller="Items" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to Items
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-box me-2"></i>Item Information
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Index" method="post" id="addItemForm" novalidate>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Item.ItemCode" class="form-label fw-semibold">
                                    <i class="fas fa-barcode me-1 text-primary"></i>Item Code
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-hashtag"></i>
                                    </span>
                                    <input asp-for="Item.ItemCode" type="text" class="form-control"
                                           placeholder="Enter unique item code" required />
                                </div>
                                <span asp-validation-for="Item.ItemCode" class="text-danger small"></span>
                                <div class="form-text">Must be a unique identifier for the item</div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Item.ItemName" class="form-label fw-semibold">
                                    <i class="fas fa-tag me-1 text-primary"></i>Item Name
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-box"></i>
                                    </span>
                                    <input asp-for="Item.ItemName" type="text" class="form-control"
                                           placeholder="Enter item name" required />
                                </div>
                                <span asp-validation-for="Item.ItemName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Item.Description" class="form-label fw-semibold">
                                <i class="fas fa-align-left me-1 text-primary"></i>Description
                            </label>
                            <textarea asp-for="Item.Description" class="form-control" rows="3"
                                      placeholder="Enter item description (optional)"></textarea>
                            <span asp-validation-for="Item.Description" class="text-danger small"></span>
                            <div class="form-text">Provide a detailed description of the item</div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Item.CategoryID" class="form-label fw-semibold">
                                    <i class="fas fa-folder me-1 text-primary"></i>Category
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-list"></i>
                                    </span>
                                    <select asp-for="Item.CategoryID" class="form-select" id="Item_CategoryID" required>
                                        <option value="" selected>Select Category</option>
                                        @if (Model.Categories != null)
                                        {
                                        @foreach (var category in Model.Categories)
                                            {
                                        <option value="@category.CategoryID">@category.CategoryName</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <span asp-validation-for="Item.CategoryID" class="text-danger small"></span>
                                @if (Model.Categories == null || !Model.Categories.Any())
                                {
                                <div class="form-text text-warning">
                                    <i class="fas fa-exclamation-triangle me-1"></i>
                                    No categories available. <a href="/Categories/Create">Create one first</a>
                                </div>
                                }
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Item.SubCategoryID" class="form-label fw-semibold">Subcategory</label>
                                <select asp-for="Item.SubCategoryID" id="Item_SubCategoryID" class="form-select">
                                    <option value="">Select Subcategory</option>
                                    @if (Model.SubCategories != null)
                                    {
                                    @foreach (var sub in Model.SubCategories)
                                        {
                                    <option value="@sub.SubCategoryID" data-code="@sub.SubCategoryCode">
                                        @sub.SubCategoryName (@sub.SubCategoryCode)
                                    </option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="Item.SubCategoryID" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Item.Unit" class="form-label fw-semibold">
                                    <i class="fas fa-ruler me-1 text-primary"></i>Unit
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-balance-scale"></i>
                                    </span>
                                    <input asp-for="Item.Unit" type="text" class="form-control"
                                           placeholder="e.g., pcs, kg, liter" required list="unitSuggestions" />
                                </div>
                                <datalist id="unitSuggestions">
                                    <option value="pcs">Pieces</option>
                                    <option value="kg">Kilograms</option>
                                    <option value="g">Grams</option>
                                    <option value="M">Meter</option>
                                    <option value="liter">Liters</option>
                                    <option value="ml">Milliliters</option>
                                    <option value="box">Boxes</option>
                                    <option value="set">Sets</option>
                                </datalist>
                                <span asp-validation-for="Item.Unit" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Item.ReorderLevel" class="form-label fw-semibold">
                                    <i class="fas fa-exclamation-triangle me-1 text-warning"></i>Reorder Level
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-bell"></i>
                                    </span>
                                    <input asp-for="Item.ReorderLevel" type="number" class="form-control"
                                           placeholder="Minimum stock level" min="0" required />
                                </div>
                                <span asp-validation-for="Item.ReorderLevel" class="text-danger small"></span>
                                <div class="form-text">Alert when stock falls below this level</div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Item.CurrentStock" class="form-label fw-semibold">
                                <i class="fas fa-cubes me-1 text-success"></i>Current Stock
                                <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-warehouse"></i>
                                </span>
                                <input asp-for="Item.CurrentStock" type="number" class="form-control"
                                       placeholder="Initial stock quantity" min="0" required />
                            </div>
                            <span asp-validation-for="Item.CurrentStock" class="text-danger small"></span>
                            <div class="form-text">Current available quantity</div>
                        </div>

                        <div class="mb-4">
                            <div class="card bg-light">
                                <div class="card-body py-2">
                                    <small class="text-muted">
                                        <i class="fas fa-info-circle me-1"></i>
                                        <strong>Stock Status Preview:</strong>
                                        <span id="stockStatus" class="badge bg-secondary ms-2">Enter stock values</span>
                                    </small>
                                </div>
                            </div>
                        </div>

                        <div id="technicalFields" class="border rounded p-3 mb-4 d-none">
                            <h5 class="text-primary mb-3"><i class="fas fa-cogs me-2"></i>Technical Specifications</h5>
                            <div class="row">
                                <div class="col-md-6 mb-3 technical-field" data-field="Length">
                                    <label asp-for="Item.ToolAttribute.Length" class="form-label">Length L (mm)<span class="text-danger">*</span></label>
                                    <input asp-for="Item.ToolAttribute.Length" type="number" class="form-control" step="0.01" />
                                    <span asp-validation-for="Item.ToolAttribute.Length" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3 technical-field" data-field="Diameter">
                                    <label asp-for="Item.ToolAttribute.Diameter" class="form-label">Diameter Φ (mm) <span class="text-danger">*</span></label>
                                    <input asp-for="Item.ToolAttribute.Diameter" type="number" class="form-control" step="0.01" />
                                    <span asp-validation-for="Item.ToolAttribute.Diameter" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3 technical-field" data-field="Radius">
                                    <label asp-for="Item.ToolAttribute.Radius" class="form-label">Radius R (mm)</label>
                                    <input type="hidden" asp-for="Item.ToolAttribute.Radius" id="RadiusFinal" />
                                    <div id="radiusInputContainer" class="input-group">
                                        <input type="number" step="0.01" class="form-control radius-manual" id="RadiusManual" placeholder="Enter radius" />
                                        <select class="form-select radius-select d-none" id="RadiusSelect">
                                            <option value="">Select Radius</option>
                                            <option value="2">2</option>
                                            <option value="3.5">3.5</option>
                                            <option value="5">5</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="Item.ToolAttribute.Radius" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3 technical-field" data-field="Hardness">
                                    <label asp-for="Item.ToolAttribute.Hardness" class="form-label">Hardness H <span class="text-danger">*</span></label>
                                    <input asp-for="Item.ToolAttribute.Hardness" type="number" class="form-control" step="0.01" />
                                    <span asp-validation-for="Item.ToolAttribute.Hardness" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3 technical-field" data-field="MaterialType">
                                    <label asp-for="Item.ToolAttribute.MaterialType" class="form-label">Kind (Carbide or HSS) <span class="text-danger">*</span></label>
                                    <select asp-for="Item.ToolAttribute.MaterialType" class="form-select">
                                        <option value="">Select Kind</option>
                                        <option value="Carbide">Carbide</option>
                                        <option value="HSS">HSS</option>
                                    </select>
                                    <span asp-validation-for="Item.ToolAttribute.MaterialType" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3 technical-field" data-field="Pitch">
                                    <label asp-for="Item.ToolAttribute.Pitch" class="form-label">Pitch (P) <span class="text-danger">*</span></label>
                                    <input asp-for="Item.ToolAttribute.Pitch" type="number" class="form-control" step="0.01" />
                                    <span asp-validation-for="Item.ToolAttribute.Pitch" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3 technical-field" data-field="LocalOrImported">
                                    <label asp-for="Item.ToolAttribute.LocalOrImported" class="form-label">Origin</label>
                                    <select asp-for="Item.ToolAttribute.LocalOrImported" class="form-select">
                                        <option value="">Select</option>
                                        <option value="Local">Local</option>
                                        <option value="Imported">Imported</option>
                                    </select>
                                    <span asp-validation-for="Item.ToolAttribute.LocalOrImported" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-outline-secondary" onclick="resetForm()">
                                <i class="fas fa-undo me-2"></i>Reset Form
                            </button>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-plus me-2"></i>Add Item
                                <span class="spinner-border spinner-border-sm ms-2 d-none" id="submitSpinner"></span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-info">
                <div class="card-header bg-info text-white">
                    <h6 class="card-title mb-0">
                        <i class="fas fa-lightbulb me-2"></i>Tips for Adding Items
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 mb-3 mb-md-0">
                            <div class="d-flex">
                                <i class="fas fa-barcode text-primary me-3 mt-1"></i>
                                <div>
                                    <h6>Item Code</h6>
                                    <small class="text-muted">Use a unique, descriptive code that follows your naming convention</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3 mb-md-0">
                            <div class="d-flex">
                                <i class="fas fa-exclamation-triangle text-warning me-3 mt-1"></i>
                                <div>
                                    <h6>Reorder Level</h6>
                                    <small class="text-muted">Set this based on your usage patterns and supplier lead times</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex">
                                <i class="fas fa-folder text-info me-3 mt-1"></i>
                                <div>
                                    <h6>Categories</h6>
                                    <small class="text-muted">Organize items into categories for better inventory management</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 0.75rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .card-header {
        border-radius: 0.75rem 0.75rem 0 0 !important;
        border: none;
    }

    .form-label {
        color: #495057;
        margin-bottom: 0.5rem;
    }

    .input-group-text {
        background-color: #f8f9fa;
        border-color: #ced4da;
        color: #6c757d;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #007bff;
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
    }

    .btn {
        border-radius: 0.5rem;
        font-weight: 500;
        transition: all 0.2s ease;
    }

        .btn:hover {
            transform: translateY(-1px);
        }

    .btn-primary {
        background: linear-gradient(135deg, #007bff, #0056b3);
        border: none;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #0056b3, #004085);
        }

    .alert {
        border-radius: 0.75rem;
        border: none;
    }

    .display-5 {
        font-weight: 300;
    }

    .form-text {
        font-size: 0.875rem;
    }

    .badge {
        font-size: 0.75rem;
        padding: 0.5em 0.75em;
    }

    @@media (max-width: 768px) {
        .display-5 {
            font-size: 2rem;
        }

        .card-body {
            padding: 1.5rem !important;
        }

        .btn {
            width: 100%;
            margin-bottom: 0.5rem;
        }

        .d-flex.justify-content-end {
            flex-direction: column;
        }
    }

    /* Custom validation styles */
    .form-control.is-invalid,
    .form-select.is-invalid {
        border-color: #dc3545;
    }

    .form-control.is-valid,
    .form-select.is-valid {
        border-color: #198754;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // Define rules for each subcategory code
            const fieldRules = {
                "E": { required: ["Diameter", "Length", "Hardness", "LocalOrImported"], optional: ["Radius"], radiusInputType: 'manual' },
                "B": { required: ["Diameter", "Length", "Hardness", "LocalOrImported"], optional: [], radiusInputType: 'manual' },
                "D": { required: ["Diameter", "Length", "Hardness", "LocalOrImported"], optional: [], radiusInputType: 'manual' },
                "M": { required: ["Diameter", "Pitch", "Length", "LocalOrImported"], optional: [], radiusInputType: 'manual' },
                "R": { required: ["Radius", "MaterialType"], optional: [], radiusInputType: 'manual' },
                "I": { required: ["Radius"], optional: [], radiusInputType: 'dropdown' },
                "S": { required: ["Diameter", "Radius"], optional: ["Length"], radiusInputType: 'dropdown', specialRules: { length: 'conditional' } }
            };

            // Function to handle the visibility and requirement of technical fields
            function showFields(code) {
                const config = fieldRules[code];

                // Hide all technical fields and remove 'required' attributes
                $('.technical-field').hide().find('input, select').removeAttr('required').val('');
                $('#technicalFields').addClass('d-none');

                if (!config) return;

                // Show the main technical fields container
                $('#technicalFields').removeClass('d-none');

                // Show required and optional fields and set 'required' for required ones
                [...config.required, ...config.optional].forEach(field => {
                    const fieldDiv = $('[data-field="' + field + '"]');
                    fieldDiv.show();
                    if (config.required.includes(field)) {
                        fieldDiv.find('input, select').attr('required', true);
                    }
                });

                // Handle Radius input type toggle
                if (config.radiusInputType === 'dropdown') {
                    $('#RadiusSelect').show().attr('required', true).removeClass('d-none');
                    $('#RadiusManual').hide().removeAttr('required').addClass('d-none');
                } else {
                    $('#RadiusSelect').hide().removeAttr('required').addClass('d-none');
                    $('#RadiusManual').show().attr('required', true).removeClass('d-none');
                }

                // Handle special conditional rules, like for "Shells" (S)
                if (code === "S" && config.specialRules.length === 'conditional') {
                    const diaInput = $('[name="ToolAttribute.Diameter"]');
                    const lengthField = $('[data-field="Length"]');

                    diaInput.on('input', function () {
                        if (parseFloat(this.value) === 15) {
                            lengthField.show().find('input').attr('required', true);
                        } else {
                            lengthField.hide().find('input').removeAttr('required');
                        }
                    }).trigger('input'); // Trigger on load
                }

                // Update the hidden Radius field
                updateRadiusFinalValue();
            }

            // Function to update the hidden Radius field with the correct value
            function updateRadiusFinalValue() {
                const code = $('#Item_SubCategoryID').find(':selected').data('code');
                const config = fieldRules[code];

                if (!config) return;

                if (config.radiusInputType === 'dropdown') {
                    $('#RadiusFinal').val($('#RadiusSelect').val());
                } else {
                    $('#RadiusFinal').val($('#RadiusManual').val());
                }
            }

            // Event handlers
            $('#Item_SubCategoryID').on('change', function () {
                const code = $(this).find(':selected').data('code');
                showFields(code);
            });

            $('#RadiusManual, #RadiusSelect').on('input change', updateRadiusFinalValue);

            // Re-trigger the change on page load to initialize the correct fields
            $('#Item_SubCategoryID').trigger('change');
        });

        // Other utility functions
        function resetForm() {
            document.getElementById('addItemForm').reset();
            // Manually re-trigger the change event to reset dynamic fields
            $('#Item_SubCategoryID').trigger('change');
            // Hide the technical fields section completely on reset
            $('#technicalFields').addClass('d-none');
            // Also reset the stock status badge
            $('#stockStatus').removeClass('bg-success bg-warning bg-danger').addClass('bg-secondary').text('Enter stock values');
        }

        // Live stock status update
        $('#Item_CurrentStock, #Item_ReorderLevel').on('input', function () {
            const currentStock = parseInt($('#Item_CurrentStock').val());
            const reorderLevel = parseInt($('#Item_ReorderLevel').val());
            const statusBadge = $('#stockStatus');

            statusBadge.removeClass('bg-secondary bg-success bg-warning bg-danger');

            if (isNaN(currentStock) || isNaN(reorderLevel)) {
                statusBadge.addClass('bg-secondary').text('Enter stock values');
            } else if (currentStock <= reorderLevel) {
                statusBadge.addClass('bg-danger').text('Low Stock');
            } else if (currentStock > reorderLevel && currentStock <= reorderLevel * 2) {
                statusBadge.addClass('bg-warning').text('Medium Stock');
            } else {
                statusBadge.addClass('bg-success').text('In Stock');
            }
        });
    </script>
}