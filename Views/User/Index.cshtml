@model IEnumerable<WarehouseApp.Models.User>

    @{
    ViewData["Title"] = "إدارة المستخدمين";
    }

    <h2 class="mb-3">إدارة المستخدمين</h2>

    <a asp-action="Create" class="btn btn-primary mb-3">➕ إضافة مستخدم جديد</a>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>اسم المستخدم</th>
                <th>الدور</th>
                <th>تاريخ الإنشاء</th>
                <th style="width:150px;">العمليات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
        {
            <tr>
                <td>@user.Username</td>
                <td>@user.Role</td>
                <td>@user.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@user.UserID" class="btn btn-sm btn-warning">تعديل</a>
                    <a asp-action="Delete" asp-route-id="@user.UserID" class="btn btn-sm btn-danger">حذف</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
