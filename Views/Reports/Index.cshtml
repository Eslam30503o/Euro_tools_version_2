@model WarehouseApp.Models.DashboardViewModel
@{
    ViewData["Title"] = "الرئيسية";
}

<div class="dashboard-container p-4">
    <!-- إحصائيات سريعة -->
    <div class="row">
        <div class="col-md-6 col-lg-3 mb-4">
            <div class="card stat-card bg-primary text-white shadow-sm">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="card-title text-uppercase mb-0">إجمالي العناصر</h5>
                        <h2 class="display-4 fw-bold mb-0">@Model.TotalItems</h2>
                    </div>
                    <i class="fas fa-box-open stat-icon fa-3x"></i>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3 mb-4">
            <div class="card stat-card bg-success text-white shadow-sm">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="card-title text-uppercase mb-0">إجمالي المخزون</h5>
                        <h2 class="display-4 fw-bold mb-0">@Model.TotalStock</h2>
                    </div>
                    <i class="fas fa-boxes stat-icon fa-3x"></i>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3 mb-4">
            <div class="card stat-card bg-info text-white shadow-sm">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="card-title text-uppercase mb-0">معاملات اليوم</h5>
                        <h2 class="display-4 fw-bold mb-0">@Model.Transactions.Where(t => t.Timestamp.Date == DateTime.Today).Count()</h2>
                    </div>
                    <i class="fas fa-exchange-alt stat-icon fa-3x"></i>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3 mb-4">
            <div class="card stat-card bg-warning text-dark shadow-sm">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="card-title text-uppercase mb-0">المنتجات منخفضة المخزون</h5>
                        <h2 class="display-4 fw-bold mb-0">@Model.LowStockItems.Count()</h2>
                        <a asp-action="LowStockItems" asp-controller="AddItem" class="btn btn-danger mt-3">
                            عرض المنتجات منخفضة المخزون
                        </a>

                    </div>
                    <i class="fas fa-exclamation-triangle stat-icon fa-3x"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- المخططات البيانية -->
    <div class="row">
        <div class="col-lg-4 mb-4">
            <div class="card chart-card shadow-sm">
                <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-bold">مستويات المخزون الحالية</h5>
                    <div>
                        <button id="sortAsc" class="btn btn-sm btn-outline-primary me-1">
                            <i class="fas fa-sort-amount-up"></i>
                        </button>
                        <button id="sortDesc" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-sort-amount-down"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="stockChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="card chart-card shadow-sm">
                <div class="card-header bg-white border-0">
                    <h5 class="card-title mb-0 fw-bold">المعاملات حسب النوع</h5>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="transactionsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="card chart-card shadow-sm">
                <div class="card-header bg-white border-0">
                    <h5 class="card-title mb-0 fw-bold">المخزون حسب التصنيف</h5>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="categoryChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- جدول آخر المعاملات -->
    <div class="card transactions-card shadow-sm mb-4">
        <div class="card-header bg-white border-0">
            <h5 class="card-title mb-0 fw-bold">آخر المعاملات</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="transactionsTable" class="table table-striped table-hover" style="width:100%">
                    <thead class="table-dark">
                        <tr>
                            <th>التاريخ</th>
                            <th>العنصر</th>
                            <th>النوع</th>
                            <th>الكمية</th>
                            <th>المستخدم</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Transactions != null && Model.Transactions.Any())
                        {
                            foreach (var transaction in Model.Transactions.Take(100))
                            {
                        <tr>
                            <td>@transaction.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@transaction.Item?.ItemName</td>
                            <td>
                                @switch (transaction.Action)
                                        {
                                            case "IN":
                                <span class="badge bg-success rounded-pill"><i class="fas fa-plus me-1"></i>إضافة</span>;
                                                break;
                                            case "OUT":
                                <span class="badge bg-danger rounded-pill"><i class="fas fa-minus me-1"></i>إزالة</span>;
                                                break;
                                            default:
                                <span class="badge bg-secondary rounded-pill"><i class="fas fa-question me-1"></i>غير معروف</span>;
                                                break;
                                        }
                            </td>
                            <td>
                                <span class="fw-bold @(transaction.Action == "IN" ? "text-success" : "text-danger")">
                                    @(transaction.Action == "IN" ? "+" : "-")@Math.Abs(transaction.QuantityChange)
                                </span>
                            </td>
                            <td>@transaction.User?.Username</td>
                        </tr>
                            }
                        }
                        else
                        {
                        <tr>
                            <td colspan="5" class="text-center text-muted">لا توجد معاملات متاحة</td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script type="text/javascript" src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script type="text/javascript" src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            // DataTables
            $('#transactionsTable').DataTable({
                "language": { "url": "//cdn.datatables.net/plug-ins/1.13.4/i18n/ar.json" },
                "order": [[0, "desc"]],
                "pageLength": 10,
                "responsive": true,
                "dom": '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rtip'
            });

            // Colors
            const colors = {
                primary: '#007bff',
                success: '#28a745',
                danger: '#dc3545',
                warning: '#ffc107',
                info: '#17a2b8',
                secondary: '#6c757d'
            };

            const chartColors = [
                'rgba(255, 99, 132, 0.8)',
                'rgba(54, 162, 235, 0.8)',
                'rgba(255, 206, 86, 0.8)',
                'rgba(75, 192, 192, 0.8)',
                'rgba(153, 102, 255, 0.8)',
                'rgba(255, 159, 64, 0.8)',
                'rgba(199, 199, 199, 0.8)',
                'rgba(83, 102, 255, 0.8)'
            ];

            // ******** Stock Chart ********
            @if (Model.Items != null && Model.Items.Any())
            {
                <text>
                    var items = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        Model.Items.Take(100).Select(i => new { i.ItemName, i.CurrentStock } )
                    ));

                    var stockCtx = document.getElementById('stockChart').getContext('2d');

                    function renderChart(sortedItems) {
                        var itemNames = sortedItems.map(i => i.ItemName);
                        var stockLevels = sortedItems.map(i => i.CurrentStock);
                        var minStock = Math.min(...stockLevels);
                        var barColors = stockLevels.map(v => v === minStock ? 'rgba(220,53,69,0.8)' : 'rgba(0,123,255,0.5)');
                        return new Chart(stockCtx, {
                            type: 'bar',
                            data: {
                                labels: itemNames,
                                datasets: [{
                                    label: 'المخزون الحالي',
                                    data: stockLevels,
                                    backgroundColor: barColors,
                                    borderColor: 'rgba(0,123,255,1)',
                                    borderWidth: 2,
                                    borderRadius: 4
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: { legend: { display: false } },
                                scales: {
                                    y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.1)' } },
                                    x: { grid: { display: false } }
                                }
                            }
                        });
                    }

                    var currentChart = renderChart([...items].sort((a,b)=> b.CurrentStock - a.CurrentStock));

                    document.getElementById('sortAsc').addEventListener('click', function () {
                        currentChart.destroy();
                        currentChart = renderChart([...items].sort((a, b) => a.CurrentStock - b.CurrentStock));
                    });

                    document.getElementById('sortDesc').addEventListener('click', function () {
                        currentChart.destroy();
                        currentChart = renderChart([...items].sort((a, b) => b.CurrentStock - a.CurrentStock));
                    });
                </text>
            }

            // ******** Transactions Chart ********
            @if (Model.Transactions != null && Model.Transactions.Any())
            {
                <text>
                    var groupedTrans = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        Model.Transactions.GroupBy(t => t.Action).Select(g => new { Action = g.Key, Count = g.Count() })
                    ));

                    var transactionTypes = groupedTrans.map(x => x.Action === 'IN' ? 'إضافة' : (x.Action === 'OUT' ? 'إزالة' : x.Action));
                    var transactionCounts = groupedTrans.map(x => x.Count);

                    var transactionsCtx = document.getElementById('transactionsChart').getContext('2d');
                    var transactionsChart = new Chart(transactionsCtx, {
                        type: 'doughnut',
                        data: {
                            labels: transactionTypes,
                            datasets: [{
                                data: transactionCounts,
                                backgroundColor: [ colors.success, colors.danger ],
                                borderColor: [ colors.success, colors.danger ],
                                borderWidth: 2
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { position: 'bottom', labels: { padding: 20, usePointStyle: true } }
                            }
                        }
                    });
                </text>
            }

            // ******** Category Chart ********
            @if (Model.ItemsByCategory != null && Model.ItemsByCategory.Any())
            {
                <text>
                    var catLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ItemsByCategory.Select(c => c.CategoryName)));
                    var catCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ItemsByCategory.Select(c => c.ItemCount)));
                    var categoryCtx = document.getElementById('categoryChart').getContext('2d');
                    var categoryChart = new Chart(categoryCtx, {
                        type: 'pie',
                        data: {
                            labels: catLabels,
                            datasets: [{
                                data: catCounts,
                                backgroundColor: chartColors.slice(0, catLabels.length),
                                borderWidth: 2,
                                borderColor: '#fff'
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { position: 'bottom', labels: { padding: 15, usePointStyle: true, font: { size: 12 } } }
                            }
                        }
                    });
                </text>
            }

            // Resize charts on window resize (Chart.js v3+)
            window.addEventListener('resize', function() {
                // Chart.js instances auto-resize — but if you stored them in variables, call update() if needed
            });

        });
    </script>

    <style>
        /* ... (انسخ بقية الستايل من القالب الذي أرسلته) ... */
        /* لتحافظ على تصميمك ضعه هنا — تم اختصاره في هذه الرسالة */
    </style>
}
